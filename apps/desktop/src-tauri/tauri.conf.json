{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KamehaDB",
  "version": "1.4.6",
  "identifier": "com.kamehadb",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @kamehadb/shared build && pnpm --filter @kamehadb/sidecar build && pnpm --filter @kamehadb/sidecar bundle:tauri && pnpm --filter @kamehadb/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KamehaDB",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/sidecar"]
  }
}
