{
  "name": "kamehadb",
  "private": true,
  "version": "2.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wails dev -tags webkit2_41",
    "dev:desktop": "pnpm --filter @kamehadb/desktop dev",
    "dev:landing": "npm --prefix landing run dev",
    "dev:all": "concurrently \"npm --prefix landing run dev\" \"pnpm dev\"",
    "build": "wails build -tags webkit2_41",
    "build:duckdb-driver": "node scripts/build-duckdb-driver.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:go": "go tool golangci-lint run",
    "test": "pnpm -r test",
    "test:go": "mkdir -p apps/desktop/dist && touch apps/desktop/dist/index.html && go test ./...",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:go": "go tool golangci-lint fmt",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.go": [
      "go tool golangci-lint fmt",
      "sh -c 'pnpm lint:go'"
    ],
    "*.{json,css,md}": "prettier --write",
    "apps/desktop/**/*.{ts,tsx}": [
      "pnpm --dir apps/desktop exec eslint --fix",
      "prettier --write"
    ],
    "packages/shared/**/*.ts": [
      "pnpm --dir packages/shared exec eslint --fix",
      "prettier --write"
    ],
    "landing/**/*.{js,jsx,ts,tsx}": [
      "npm --prefix landing run lint -- --fix",
      "prettier --write"
    ],
    "./*.{js,jsx,ts,tsx}": "prettier --write",
    "apps/desktop/*.{js,jsx,ts,tsx}": "prettier --write",
    "packages/shared/*.{js,jsx,ts,tsx}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "concurrently": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "~5.8.3"
  }
}
