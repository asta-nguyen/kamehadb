{
  "name": "kamehadb",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @kamehadb/sidecar dev\" \"pnpm --filter @kamehadb/desktop dev\"",
    "dev:desktop": "pnpm --filter @kamehadb/desktop dev",
    "dev:sidecar": "pnpm --filter @kamehadb/sidecar dev",
    "dev:landing": "npm --prefix landing run dev",
    "dev:all": "concurrently \"npm --prefix landing run dev\" \"pnpm dev:desktop\" \"pnpm dev:sidecar\"",
    "build": "pnpm --filter @kamehadb/sidecar build && pnpm --filter @kamehadb/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "pnpm --filter @kamehadb/desktop tauri",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "duckdb",
      "esbuild",
      "msw",
      "node-pty",
      "oracledb",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "concurrently": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "~5.8.3"
  }
}
